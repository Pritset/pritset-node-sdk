{
  "name": "@pritset/sdk",
  "version": "0.1.3",
  "description": "Official Node.js SDK for the Pritset document API",
  "license": "MIT",
  "author": "Pritset",
  "homepage": "https://github.com/Pritset/pritset-node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pritset/pritset-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Pritset/pritset-node-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { 
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contract:check": "node scripts/verify-contract.mjs",
    "pack:check": "node scripts/verify-package.mjs",
    "staging:test": "npm run build && node scripts/staging-lifecycle.mjs",
    "verify": "npm run contract:check && npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "form-data": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^18.19.120",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
